# Environment
NODE_ENV=development

# Backend Server
PORT=3001
HOST=localhost

# x402 — Algorand receiving wallet (58-char Algorand address)
AVM_ADDRESS=

# x402 — Facilitator URL (GoPlausible; no trailing slash)
FACILITATOR_URL=https://facilitator.goplausible.xyz


# Frontend
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_NAME=AlgoForge

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/algoforge

# x402 Configuration
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_NETWORK=algorand:testnet-v1.0
X402_PAY_TO_ADDRESS=
X402_ASSET=USDC_TESTNET_ASA_ID
X402_DEFAULT_PRICE=0.02
X402_MAX_TIMEOUT_SECONDS=300

# Algorand
ALGORAND_TESTNET_RPC=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud

# AI/SLM Configuration
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Analysis Engine
MAX_UPLOAD_SIZE=52428800
MAX_FILES_PER_ANALYSIS=100
ANALYSIS_TIMEOUT_MS=120000

# Security
JWT_SECRET=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
